    {
        public Form1()
        {
            InitializeComponent();
        }

        private void cmbWeapon_SelectedIndexChanged(object sender, EventArgs e)
        {

        }

        private void btnFight_Click(object sender, EventArgs e)
        {
            string weapon = cmbWeapon.Text;
            switch (weapon)

            {
                case "Sword":
                    lblResult.Text = "You attacked with a sword!";
                    break;

                case "Bow":
                    lblResult.Text = "You attacked with a bow!";
                    break;

                case "Magic":
                    lblResult.Text = "You attacked with magic!";
                    break;

                default:
                    lblResult.Text = "Please select a weapon first.";
                    break;
            }
        }
    }
}

