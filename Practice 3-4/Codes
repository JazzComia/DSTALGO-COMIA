// 2 Guess the Number
namespace GuessTheNumber
{
    public partial class Form1 : Form
    {
        public Form1()
        {
            InitializeComponent();
        }

        private void pictureBox1_Click(object sender, EventArgs e)
        {

        }

        private void btnGuess_Click(object sender, EventArgs e)
        {
            int secret = 29;
            int guess = Convert.ToInt32(txtGuess.Text);

            while (guess != secret)
            {
                lblMessage.Text = "Wrong guess! Try again.";
                return;
            }
            lblMessage.Text = "You guessed it right! The secret number is " + secret + ".";
        }
    }
}

// 3 Coin Collector
namespace Coin_Collector
{
    public partial class Form1 : Form
    {
        public Form1()
        {
            InitializeComponent();
        }

        // Keep clicking the button until 100
        private void button1_Click(object sender, EventArgs e)
        {
            int coins = 0;

            do
            {
                coins += 10;
            }
                while (coins < 100);

            lblCoins.Text = "You have collected " + coins + " coins!";
        }
    }
}

// 4 Defeat the Monster
namespace Defeat_the_Monster
{
    public partial class Form1 : Form
    {
        public Form1()
        {
            InitializeComponent();
        }

        private void btnFight_Click(object sender, EventArgs e)
        {
            int hp = 50;
            string result = "";

            do
            {
                hp -= 10;
                result += "Monster takes 10 damage! HP left: " + hp + "\n";
            }
            while (hp > 0);

            result += "Monster defeated!";

            label1.Text = result;
        }
    }
}

