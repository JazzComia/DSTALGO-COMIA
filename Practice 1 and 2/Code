namespace DSTALGO_Prac_1
{
    public partial class Form1 : Form
    {
        public Form1()
        {
            InitializeComponent();
        }

        private void button1_Click(object sender, EventArgs e)
        {
            int num = Convert.ToInt32(txtNum.Text);

            if (num % 2 == 0)
            {
                lblResult.Text = "Even";
            }
            else
            {
                lblResult.Text = "Odd";
            }
        }
    }
}


