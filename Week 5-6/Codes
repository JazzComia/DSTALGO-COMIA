namespace exponential
{
    public partial class Form1 : Form
    {
        public Form1()
        {
            InitializeComponent();
        }

        private void button1_Click(object sender, EventArgs e)
        {
            int positions = 4;
            string correctPin = "4331";
            int possibilities = 1;

            for (int i = 0; i < positions; i++)
            {
                possibilities = possibilities * 10;
            }

            for (int k = 0; k < possibilities; k++)
            {
                string guess = k.ToString().PadLeft(positions, '0');

                if (guess == correctPin)
                {
                    lblPin.Text = "PIN found: " + guess + "\nTries: " + (k + 1) + " out of " + possibilities;
                    break;
                }
            }
        }
    }
}

