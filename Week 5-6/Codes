namespace WinFormsApp2
{
    public partial class Form1 : Form
    {
        public Form1()
        {
            InitializeComponent();
        }

        private void button1_Click(object sender, EventArgs e)
        {
            int number = 625;
            int steps = 0;

            lblDivide.Text = "";

            while (number > 1)
            {
                number = number / 5;
                steps = steps + 1;
                lblDivide.Text = lblDivide.Text + "Step " + steps + ": " + number + "\n";
            }

            lblDivide.Text = lblDivide.Text + "Total steps: " + steps;
        }
    }
}

namespace WinFormsApp3
{
    public partial class Form1 : Form
    {
        public Form1()
        {
            InitializeComponent();
        }

        private void button1_Click(object sender, EventArgs e)
        {
            int[] numbers = { 40, 45, 50, 55, 60, 65, 70, 75, 80 };

            int left = 0;
            int right = numbers.Length - 1;

            lblSearch.Text = "Not found";

            while (left <= right)
            {
                int middle = (left + right) / 2;

                if (numbers[middle] == 60)
                {
                    lblSearch.Text = "Found at index " + middle;
                    break;
                }
                else if (numbers[middle] < 60)
                {
                    left = middle + 1;
                }
                else
                {
                    right = middle - 1;
                }
            }
        }
    }
}

